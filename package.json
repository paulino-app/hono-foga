{
  "name": "hono-foga",
  "version": "2.3.0",
  "description": "Shared toolkit for Hono based services: OpenAPI helpers, decorators, status codes, validation and small utilities.",
  "type": "module",
  "sideEffects": [
    "./dist/polyfill/compression.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "import": "./dist/decorators/index.js"
    },
    "./decorators/*": {
      "types": "./dist/decorators/*.d.ts",
      "import": "./dist/decorators/*.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./formatting": {
      "types": "./dist/formatting/index.d.ts",
      "import": "./dist/formatting/index.js"
    },
    "./formatting/*": {
      "types": "./dist/formatting/*.d.ts",
      "import": "./dist/formatting/*.js"
    },
    "./framework": {
      "types": "./dist/framework/index.d.ts",
      "import": "./dist/framework/index.js"
    },
    "./framework/*": {
      "types": "./dist/framework/*.d.ts",
      "import": "./dist/framework/*.js"
    },
    "./framework/middlewares": {
      "types": "./dist/framework/middlewares/index.d.ts",
      "import": "./dist/framework/middlewares/index.js"
    },
    "./framework/middlewares/*": {
      "types": "./dist/framework/middlewares/*.d.ts",
      "import": "./dist/framework/middlewares/*.js"
    },
    "./framework/context": {
      "types": "./dist/framework/context/index.d.ts",
      "import": "./dist/framework/context/index.js"
    },
    "./framework/context/json/*": {
      "types": "./dist/framework/context/json/*.d.ts",
      "import": "./dist/framework/context/json/*.js"
    },
    "./framework/context/params/*": {
      "types": "./dist/framework/context/params/*.d.ts",
      "import": "./dist/framework/context/params/*.js"
    },
    "./framework/context/query/*": {
      "types": "./dist/framework/context/query/*.d.ts",
      "import": "./dist/framework/context/query/*.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js"
    },
    "./openapi/helpers": {
      "types": "./dist/openapi/helpers/index.d.ts",
      "import": "./dist/openapi/helpers/index.js"
    },
    "./openapi/helpers/*": {
      "types": "./dist/openapi/helpers/*.d.ts",
      "import": "./dist/openapi/helpers/*.js"
    },
    "./openapi/schemas": {
      "types": "./dist/openapi/schemas/index.d.ts",
      "import": "./dist/openapi/schemas/index.js"
    },
    "./openapi/schemas/*": {
      "types": "./dist/openapi/schemas/*.d.ts",
      "import": "./dist/openapi/schemas/*.js"
    },
    "./openapi/default-hook": {
      "types": "./dist/openapi/default-hook.d.ts",
      "import": "./dist/openapi/default-hook.js"
    },
    "./openapi/scalar": {
      "types": "./dist/openapi/scalar.d.ts",
      "import": "./dist/openapi/scalar.js"
    },
    "./polyfill/compression": {
      "import": "./dist/polyfill/compression.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    },
    "./security/*": {
      "types": "./dist/security/*.d.ts",
      "import": "./dist/security/*.js"
    },
    "./network/*": {
      "types": "./dist/network/*.d.ts",
      "import": "./dist/network/*.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./errors/*": {
      "types": "./dist/errors/*.d.ts",
      "import": "./dist/errors/*.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./validation/*": {
      "types": "./dist/validation/*.d.ts",
      "import": "./dist/validation/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "node scripts/clean.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "bun test",
    "check:package": "npm run clean && npm run build && node scripts/check-package.mjs",
    "lint": "bunx oxlint@latest --fix --ignore-pattern 'node_modules/**' --ignore-pattern 'dist/**'",
    "pretty": "prettier --write \"./src/**/*.{js,ts,json}\""
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "jose": "^6.2.2",
    "nanoid": "^5.1.7"
  },
  "peerDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.0.0",
    "@hono/zod-openapi": "^0.19.0",
    "@scalar/hono-api-reference": "^0.5.0",
    "hono": "^4.0.0",
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "@scalar/hono-api-reference": {
      "optional": true
    }
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@hono/zod-openapi": "^0.19.10",
    "@scalar/hono-api-reference": "^0.5.184",
    "@types/bun": "latest",
    "hono": "^4.12.9",
    "openapi3-ts": "^4.6.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "hono",
    "openapi",
    "zod",
    "toolkit",
    "framework"
  ],
  "author": "paulino-app <main.pao.tech@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulino-app/hono-foga.git"
  },
  "homepage": "https://github.com/paulino-app/hono-foga#readme",
  "bugs": {
    "url": "https://github.com/paulino-app/hono-foga/issues"
  }
}
